# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local email/HTML exports (not project docs)
email-list-*.html

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Google / GSC credentials (never commit)
*.service-account.json
*service-account*.json
google-credentials.json
*.credentials.json

# GSC export artifacts (regenerate locally; summary may be committed separately)
reports/gsc/*.json
reports/gsc/*.csv

# GEO weekly reports (owner-filled; keep week-001-template.md)
reports/geo-weekly/week-*.md
!reports/geo-weekly/week-001-template.md
reports/ai-citations/

# GSC OAuth token cache (local only)
.cache/
.cache/google-gsc-token.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# next-agents-md
.next-docs/

test-results/

# local AI/codex config
.codex/
**/__pycache__/
