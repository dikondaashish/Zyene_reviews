{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "zyenereviews.com" }],
      "destination": "https://www.zyenereviews.com/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-digest",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 14 * * 1"
    },
    {
      "path": "/api/cron/aeo-yearly-credit-reset",
      "schedule": "0 6 * * *"
    }
  ]
}
