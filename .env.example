# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App domains
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_APP_NAME=Zyene Reviews

# Google / GBP
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PUBSUB_TOPIC_NAME=
# Pub/Sub HTTP push verification (query param `token` on the push subscription URL).
# Example push endpoint:
#   https://<your-app>/api/webhooks/google/pubsub?token=<same value as below>
# On success this route enqueues Inngest `review/sync.platform` for the matching Google `review_platforms` row.
GOOGLE_PUBSUB_VERIFICATION_TOKEN=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_MONTHLY_PRICE_ID=
STRIPE_STARTER_YEARLY_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_NEW_CUSTOMER_COUPON_ID=
STRIPE_NEW_PRO_CUSTOMER_COUPON_ID=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_URL=

# Webhook hardening (GBP Pub/Sub push)
# Option A — Inngest fan-out only (recommended): POST /api/webhooks/google/pubsub?token=<GOOGLE_PUBSUB_VERIFICATION_TOKEN>
# Option B — Legacy single-review processor: POST /api/webhooks/google/gbp-reviews?token=<GOOGLE_GBP_WEBHOOK_SECRET>
# Google does not send custom headers. Set the Pub/Sub subscription push endpoint URL accordingly.
# Trailing/leading spaces in Vercel env or in the GCP push URL token break auth (401). Redeploy after changing.
# After setting GOOGLE_PUBSUB_TOPIC_NAME in production, run a Google review sync once so GBP re-registers notifications on that topic.
# In Google Cloud (project for this app / topic): enable API "My Business Notifications API" (mybusinessnotifications.googleapis.com)
# or account-level Pub/Sub registration fails and no review messages reach your topic.
GOOGLE_GBP_WEBHOOK_SECRET=

# Resend (transactional email — team invites, alerts, etc.)
RESEND_API_KEY=
# Optional. Must be a verified sender in Resend, e.g. Zyene Reviews <notifications@yourdomain.com>
# If unset, the app uses notifications@zyenereviews.com (that domain must be verified in Resend).
RESEND_FROM=

# Inngest (two different values from Inngest → your app → Keys / Signing Key)
# EVENT_KEY: used when this app sends events (e.g. inngest.send). SIGNING_KEY: verifies Inngest→your /api/inngest calls.
# If Vercel Deployment Protection is on, set Inngest's Vercel integration "Deployment protection key" to Vercel's
# Protection Bypass for Automation secret (Project Settings → Deployment Protection), or Inngest will never run jobs (0 runs).
# Optional: public origin Inngest should call (must match where the bypass applies), e.g. https://app.zyenereviews.com
# If unset, production uses NEXT_PUBLIC_APP_URL. Prevents registering *.vercel.app while the app lives on a custom domain.
INNGEST_SERVE_HOST=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Never set INNGEST_DEV on Vercel — it forces dev mode and Inngest Cloud will not execute your functions.

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Security / jobs
# Weekly digest: schedule externally (e.g. cron-job.org) every Monday 09:00 in your timezone:
#   GET https://<your-app>/api/cron/weekly-digest
#   Header: Authorization: Bearer <CRON_SECRET>
# Competitor watch (same Bearer): GET https://<your-app>/api/cron/competitor-watch — schedule daily or a few times per week.
# One-shot GBP Pub/Sub: register My Business Notifications API settings for every connected Google account (deduped by `google_account_id`). Requires `GOOGLE_PUBSUB_TOPIC_NAME`. Run after adding the topic or if reviews are not pushed to Pub/Sub:
#   GET https://<your-app>/api/cron/register-google-pubsub-notifications
#   Header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Better Stack heartbeat URL for "Review Sync Job" (Uptime → Heartbeats → copy URL).
# Must match the monitor you alert on. If unset, a legacy URL in code is used.
# Set the monitor's "expect heartbeat every" to match how often sync actually runs (e.g. 24h if daily).
BETTERSTACK_REVIEW_SYNC_HEARTBEAT_URL=
ENCRYPTION_KEY=

# Google Vertex AI (Service Account)
GCP_PROJECT_ID=zyene-reviews
GCP_REGION=us-central1
# ── AI Model Routing ──
# Primary model for user-facing tasks (suggest-reply, Q&A, batch analysis, insights, review-flow).
# Default: gemini-3-flash-preview (update to stable id when GA)
# GOOGLE_AI_PRIMARY_MODEL=gemini-3-flash-preview
# Fallback if primary errors. Default: gemini-2.5-flash
# GOOGLE_AI_FALLBACK_MODEL=gemini-2.5-flash
# Cheap model for background classification (single-review sentiment, private feedback category).
# Default: gemini-3.1-flash-lite-preview (update to stable id when GA)
# GOOGLE_AI_LITE_MODEL=gemini-3.1-flash-lite-preview
# Optional: override model for suggest-reply only (defaults to GOOGLE_AI_PRIMARY_MODEL).
# GOOGLE_AI_SUGGEST_REPLY_MODEL=
# Path to JSON key file (local dev)
# GOOGLE_APPLICATION_CREDENTIALS=~/.gcp/zyene-reviews-vertex.json
# Or raw JSON string / base64 (CI/Production)
# GOOGLE_VERTEX_CREDENTIALS_JSON=

# Facebook
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Yelp
YELP_API_KEY=

# Sentry (Error Tracking)
NEXT_PUBLIC_SENTRY_DSN=

# Logging
LOG_LEVEL=debug
