# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Auth emails (signup confirmation, password reset) use Supabase’s mail quota by default.
# If users see “Email rate limit exceeded”, add custom SMTP under Supabase → Authentication → Emails (e.g. Resend).

# App domains
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_APP_NAME=Zyene Reviews

# Google / GBP
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Places API (New) — required for Phase 7 free tools (/tools) business search & reputation checker
GOOGLE_MAPS_API_KEY=
GOOGLE_PUBSUB_TOPIC_NAME=
# Pub/Sub HTTP push verification (query param `token` on the push subscription URL).
# Example push endpoint:
#   https://<your-app>/api/webhooks/google/pubsub?token=<same value as below>
# On success this route enqueues Inngest `review/sync.platform` for the matching Google `review_platforms` row.
GOOGLE_PUBSUB_VERIFICATION_TOKEN=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_MONTHLY_PRICE_ID=
STRIPE_STARTER_YEARLY_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_NEW_CUSTOMER_COUPON_ID=
STRIPE_NEW_PRO_CUSTOMER_COUPON_ID=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_URL=

# Webhook hardening (GBP Pub/Sub push)
# Option A — Inngest fan-out only (recommended): POST /api/webhooks/google/pubsub?token=<GOOGLE_PUBSUB_VERIFICATION_TOKEN>
# Option B — Legacy single-review processor: POST /api/webhooks/google/gbp-reviews?token=<GOOGLE_GBP_WEBHOOK_SECRET>
# Google does not send custom headers. Set the Pub/Sub subscription push endpoint URL accordingly.
# Trailing/leading spaces in Vercel env or in the GCP push URL token break auth (401). Redeploy after changing.
# After setting GOOGLE_PUBSUB_TOPIC_NAME in production, run a Google review sync once so GBP re-registers notifications on that topic.
# In Google Cloud (project for this app / topic): enable API "My Business Notifications API" (mybusinessnotifications.googleapis.com)
# or account-level Pub/Sub registration fails and no review messages reach your topic.
GOOGLE_GBP_WEBHOOK_SECRET=

# Resend (transactional email — team invites, alerts, etc.)
RESEND_API_KEY=
# Optional. Must be a verified sender in Resend, e.g. Zyene Reviews <notifications@yourdomain.com>
# If unset, the app uses notifications@zyenereviews.com (that domain must be verified in Resend).
RESEND_FROM=
# Resend → Webhooks → Signing secret (Svix). Required for POST /api/webhooks/resend (delivered/opened/clicked/bounced).
RESEND_WEBHOOK_SECRET=

# Inngest (two different values from Inngest → your app → Keys / Signing Key)
# EVENT_KEY: used when this app sends events (e.g. inngest.send). SIGNING_KEY: verifies Inngest→your /api/inngest calls.
# If Vercel Deployment Protection is on, set Inngest's Vercel integration "Deployment protection key" to Vercel's
# Protection Bypass for Automation secret (Project Settings → Deployment Protection), or Inngest will never run jobs (0 runs).
# Optional: public origin Inngest should call (must match where the bypass applies), e.g. https://app.zyenereviews.com
# If unset, production uses NEXT_PUBLIC_APP_URL. Prevents registering *.vercel.app while the app lives on a custom domain.
INNGEST_SERVE_HOST=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Never set INNGEST_DEV on Vercel — it forces dev mode and Inngest Cloud will not execute your functions.

# Upstash Redis (required on Vercel production — app throws at runtime if missing)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Security / jobs — external scheduler: https://cron-job.org (cron-jobs.org)
# Create one cron-job.org job per row below. For each job:
#   • Request method: GET
#   • URL: https://app.zyenereviews.com/api/cron/<path>  (or your NEXT_PUBLIC_APP_URL)
#   • HTTP header: Authorization = Bearer <same value as CRON_SECRET in Vercel>
#   • Set timezone on the job to match your business (e.g. America/Chicago)
# Do NOT rely on Vercel Cron unless you also add x-vercel-cron; cron-jobs.org uses Bearer only.
#
# | Job title (suggested)        | Path                              | Schedule (example)        |
# |-----------------------------|-----------------------------------|---------------------------|
# | Daily digest heartbeat      | /api/cron/daily-digest            | Every day 08:00           |
# | Weekly digest emails        | /api/cron/weekly-digest           | Mon 09:00                 |
# | Google review sync          | /api/cron/sync-reviews            | Every 12 hours            |
# | Follow-up reminders         | /api/cron/follow-up               | Every day 10:00           |
# | Google performance metrics  | /api/cron/google-performance      | Every day 03:00           |
# | Scheduled review requests   | /api/cron/scheduled-review-requests | Every 5 minutes       |
# | Competitor watch            | /api/cron/competitor-watch        | Daily or 2×/week          |
# | Monthly marketing newsletter| /api/cron/monthly-newsletter      | 1st of month 10:00 (0 10 1 * *) |
# | GBP Pub/Sub registration    | /api/cron/register-google-pubsub-notifications | Manual / after topic change |
#
CRON_SECRET=

# Internal growth KPI dashboard at /growth (falls back to CRON_SECRET if unset)
GROWTH_DASHBOARD_SECRET=
# Optional: last-30-day marketing sessions for visitor→signup % on /growth
# GROWTH_MARKETING_SESSIONS_30D=5000
# Optional: prior month MRR in cents for MoM % on /growth
# GROWTH_MRR_PREVIOUS_MONTH_CENTS=100000
# Optional: cron-job.org REST API key (Console → Settings). Used by `pnpm run cron:monthly-newsletter`
CRON_JOB_ORG_API_KEY=
# Optional timezone for monthly newsletter job (default America/Chicago)
CRON_JOB_TIMEZONE=
# Referral program: Stripe customer balance credit (cents) when a referral converts to paid (default 2999 = ~$29.99)
REFERRAL_REWARD_CENTS=2999
# Phase 8 — Enterprise demo page: Cal.com inline embed (?embed=true added automatically if omitted)
# Default in code: https://cal.com/zyene/30-min-meeting?overlayCalendar=true
NEXT_PUBLIC_CAL_COM_EMBED_URL=https://cal.com/zyene/30-min-meeting?overlayCalendar=true
# Inbound demo form notifications (defaults to sales@zyenereviews.com)
DEMO_INBOUND_EMAIL=sales@zyenereviews.com
# Better Stack heartbeat URL for "Review Sync Job" (Uptime → Heartbeats → copy URL).
# Must match the monitor you alert on. If unset, a legacy URL in code is used.
# Set the monitor's "expect heartbeat every" to match how often sync actually runs (e.g. 24h if daily).
BETTERSTACK_REVIEW_SYNC_HEARTBEAT_URL=
# Weekly digest cron (GET /api/cron/weekly-digest). Daily heartbeat-only: GET /api/cron/daily-digest.
# Paste the heartbeat base URL from Better Stack → Heartbeats (legacy URL is baked in if unset).
# CRITICAL: In Better Stack, set "Expected every" to 7 days (weekly), NOT 1 day — otherwise you get false
# "Missed heartbeat" incidents between digest runs. Optional: use 8 days for grace if the job can slip slightly.
# Legacy alias still read by code: BETTERSTACK_DAILY_DIGEST_HEARTBEAT_URL (digest is weekly only; prefer WEEKLY).
BETTERSTACK_WEEKLY_DIGEST_HEARTBEAT_URL=
# Follow-up reminders cron (GET /api/cron/follow-up). Pings on every successful run, including when there are zero active follow-up campaigns.
# Set Better Stack "Expected every" to match your scheduler (e.g. 24h if daily). If unset, a legacy URL in code is used.
BETTERSTACK_FOLLOW_UP_HEARTBEAT_URL=
# Optional today: OAuth tokens use Supabase RPC encrypt_token/decrypt_token, not this key.
ENCRYPTION_KEY=

# Google Vertex AI (Service Account)
GCP_PROJECT_ID=zyene-reviews
GCP_REGION=us-central1
# ── AI Model Routing ──
# Primary model for user-facing tasks (suggest-reply, Q&A, batch analysis, insights, review-flow).
# Default: gemini-3.1-flash-lite
# GOOGLE_AI_PRIMARY_MODEL=gemini-3.1-flash-lite
# Fallback if primary errors. Default: gemini-3.5-flash
# GOOGLE_AI_FALLBACK_MODEL=gemini-3.5-flash
# Cheap model for background classification (single-review sentiment, private feedback category).
# Default: gemini-3.1-flash-lite-preview (override if 3.1-flash-lite unavailable in your project)
# GOOGLE_AI_LITE_MODEL=gemini-3.1-flash-lite-preview
# Optional: override model for suggest-reply only (defaults to GOOGLE_AI_PRIMARY_MODEL).
# GOOGLE_AI_SUGGEST_REPLY_MODEL=
# Path to JSON key file (local dev)
# GOOGLE_APPLICATION_CREDENTIALS=~/.gcp/zyene-reviews-vertex.json
# Or raw JSON string / base64 (CI/Production)
# GOOGLE_VERTEX_CREDENTIALS_JSON=

# Facebook
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Yelp
YELP_API_KEY=

# Sentry (Error Tracking)
NEXT_PUBLIC_SENTRY_DSN=

# Logging
LOG_LEVEL=debug
