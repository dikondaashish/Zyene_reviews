# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App domains
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_APP_NAME=Zyene Reviews

# Google / GBP
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PUBSUB_TOPIC_NAME=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_MONTHLY_PRICE_ID=
STRIPE_STARTER_YEARLY_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_NEW_CUSTOMER_COUPON_ID=
STRIPE_NEW_PRO_CUSTOMER_COUPON_ID=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_URL=

# Webhook hardening (GBP Pub/Sub push → POST /api/webhooks/google/gbp-reviews)
# Google does not send custom headers. Set the Pub/Sub subscription push endpoint to:
#   https://<your-app>/api/webhooks/google/gbp-reviews?token=<same value as below>
GOOGLE_GBP_WEBHOOK_SECRET=

# Resend
RESEND_API_KEY=

# Inngest (two different values from Inngest → your app → Keys / Signing Key)
# EVENT_KEY: used when this app sends events (e.g. inngest.send). SIGNING_KEY: verifies Inngest→your /api/inngest calls.
# If Vercel Deployment Protection is on, set Inngest’s Vercel integration “Deployment protection key” to Vercel’s
# Protection Bypass for Automation secret (Project Settings → Deployment Protection), or Inngest will never run jobs (0 runs).
# Optional: public origin Inngest should call (must match where the bypass applies), e.g. https://app.zyenereviews.com
# If unset, production uses NEXT_PUBLIC_APP_URL. Prevents registering *.vercel.app while the app lives on a custom domain.
INNGEST_SERVE_HOST=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Never set INNGEST_DEV on Vercel — it forces dev mode and Inngest Cloud will not execute your functions.

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Security / jobs
# Weekly digest: schedule externally (e.g. cron-jobs.org) every Monday 09:00 in your timezone:
#   GET https://<your-app>/api/cron/weekly-digest
#   Header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Better Stack heartbeat URL for “Review Sync Job” (Uptime → Heartbeats → copy URL).
# Must match the monitor you alert on. If unset, a legacy URL in code is used.
# Set the monitor’s “expect heartbeat every” to match how often sync actually runs (e.g. 24h if daily).
BETTERSTACK_REVIEW_SYNC_HEARTBEAT_URL=
ENCRYPTION_KEY=

# Google Cloud project (also used by Discovery Engine + Vertex Claude)
GCP_PROJECT_ID=zyene-reviews
GCP_REGION=us-central1
# Path to JSON key file (local dev) — recommended; multiline JSON in .env is error-prone
# GOOGLE_APPLICATION_CREDENTIALS=~/.gcp/zyene-reviews-vertex.json
# Or entire service account JSON on one line, or base64 (Vercel / CI) — also used by Discovery Engine
# GOOGLE_VERTEX_CREDENTIALS=

# Vertex AI Search / Agent Builder (Discovery Engine) — grounded generative search for reviews & Q&A
# Create a data store in Cloud Console → Vertex AI Search / Agent Builder, then copy its ID.
DISCOVERY_ENGINE_DATA_STORE_ID=
# Data store region — must match how the data store was created (console/API path uses this). Common: global, us, eu.
# If you see "endpoint can only serve us but got global", set this to us and use a US-created data store (see docs/locations).
DISCOVERY_ENGINE_LOCATION=global
DISCOVERY_ENGINE_COLLECTION=default_collection
# Serving config id from the data store (try default_search; some UIs use default_serving_config)
DISCOVERY_ENGINE_SERVING_CONFIG=default_search
# Optional override, e.g. us-discoveryengine.googleapis.com
# DISCOVERY_ENGINE_API_ENDPOINT=

# Facebook
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Yelp
YELP_API_KEY=

# Sentry (Error Tracking)
NEXT_PUBLIC_SENTRY_DSN=

# Logging
LOG_LEVEL=debug

